#!/bin/sh

# Regenerates aws-s3-egress-ranges (next to this script) from AWS's published
# address list (https://ip-ranges.amazonaws.com/ip-ranges.json): the S3 ranges
# in eu-west-1, where the FunFair Sleet NuGet feeds live (the dotnet-nuget and
# dotnet-nuget-prerelease buckets the funfair-release and funfair-prerelease
# proxies fetch from). Run it on a workstation or in CI, not on a dev package
# cache. egress/sync (devpkg-firewall-sync.timer) then applies the new list.
#
# S3 answers every lookup with a different handful of a very large pool, so a
# resolved address list would miss; the published range is allowed instead.

set -eu

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
OUT="${SCRIPTDIR}/aws-s3-egress-ranges"
REGION="eu-west-1"

curl -fsS https://ip-ranges.amazonaws.com/ip-ranges.json | python3 -c '
import ipaddress, json, sys
region = sys.argv[1]
data = json.load(sys.stdin)
nets = set()
for key, field in (("prefixes", "ip_prefix"), ("ipv6_prefixes", "ipv6_prefix")):
    for p in data.get(key, []):
        if p.get("service") == "S3" and p.get("region") == region:
            nets.add(ipaddress.ip_network(p[field]))
print(f"# AWS S3 {region} ranges from https://ip-ranges.amazonaws.com/ip-ranges.json.")
print("# Generated by egress/update-aws-s3-egress-ranges - do not edit by hand.")
for family in (4, 6):
    for net in ipaddress.collapse_addresses(n for n in nets if n.version == family):
        print(net)
' "${REGION}" > "${OUT}.tmp"
mv "${OUT}.tmp" "${OUT}"
echo "Wrote $(grep -vc '^#' "${OUT}") ranges to ${OUT}"
