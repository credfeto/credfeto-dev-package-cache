# Copy this file to .env and adjust the values to override the defaults.

API_NUGET_URL=https://api.nuget.local:5555
FUNFAIR_NUGET_URL=https://funfair.nuget.local:5555
FUNFAIR_PRERELEASE_NUGET_URL=https://funfair-prerelease.nuget.local:5555
NPM_URL=https://npm.local:5555

# Watchtower update check schedule.
# 6-field cron expression with seconds first: second minute hour day-of-month month day-of-week
# Default: 0 6 * * * * (at 6 minutes past every hour)
WATCHTOWER_SCHEDULE="0 6 * * * *"
